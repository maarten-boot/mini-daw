# Writes the build information (P28a, SPEC-UI-18): the commit, its date and the
# CI run that built it. Run at every build by the target minidaw_build_info;
# the file is only rewritten when its text changes, so nothing recompiles
# without a reason.
#
#   cmake -DSOURCE_DIR=<repo> -DOUT=<build_info.cpp> -P build_info.cmake

set(commit "")
set(date "")
set(changes 0)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%h%n%cs
                    WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE rc
                    OUTPUT_VARIABLE out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND out MATCHES "^([0-9a-f]+)\n([0-9-]+)$")
        set(commit "${CMAKE_MATCH_1}")
        set(date "${CMAKE_MATCH_2}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
                        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE rc
                        OUTPUT_VARIABLE out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(rc EQUAL 0 AND NOT out STREQUAL "")
            set(changes 1)
        endif()
    endif()
endif()
set(run "$ENV{GITHUB_RUN_ID}")
if(NOT run MATCHES "^[0-9]+$")
    set(run "")
endif()

set(text "// Generated by cmake/build_info.cmake at build time. Do not edit.
#include \"minidaw/build_info.hpp\"

namespace minidaw {

const BuildInfo& buildInfo()
{
    static const BuildInfo info{\"${commit}\", \"${date}\", ${changes} != 0, \"${run}\"};
    return info;
}

} // namespace minidaw
")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
