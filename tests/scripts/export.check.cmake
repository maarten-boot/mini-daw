# Extra check of the script case "export" (crosscheck #22 CC8), included by
# run_script.cmake: the file unpacks with CMake's ZIP reader and holds the test
# synth's state as a .vstpreset ("VST3" header).
set(file "${WORK}/out/Song.dawproject")
if(NOT EXISTS "${file}")
    message(FATAL_ERROR "${file} was not written")
endif()
file(REMOVE_RECURSE "${WORK}/unpacked")
file(ARCHIVE_EXTRACT INPUT "${file}" DESTINATION "${WORK}/unpacked")
file(GLOB presets "${WORK}/unpacked/plugins/*.vstpreset")
list(LENGTH presets n)
if(NOT n EQUAL 1)
    message(FATAL_ERROR "expected one .vstpreset in the file, found ${n}")
endif()
file(READ "${presets}" head LIMIT 4)
if(NOT head STREQUAL "VST3")
    message(FATAL_ERROR "the .vstpreset does not start with VST3: ${head}")
endif()
file(READ "${WORK}/unpacked/project.xml" xml)
string(FIND "${xml}" "<State path=\"plugins/" at)
if(at EQUAL -1)
    message(FATAL_ERROR "project.xml does not name the instrument's state")
endif()
message("export: the file holds the instrument's state")
